// Keep Zellij close to its defaults.
default_shell "/bin/zsh"

// Selecting text should not replace the clipboard until you copy it.
copy_on_select false

theme "everforest"

themes {
    everforest {
        fg 211 198 170
        bg 39 46 51
        black 65 75 80
        red 230 126 128
        green 167 192 128
        yellow 219 188 127
        blue 127 187 179
        magenta 214 153 182
        cyan 131 192 146
        white 211 198 170
        orange 230 152 117
    }
}
